Algoritmo calcCapitalInvertido
	// definir variables
	Definir capitalInvertido, rendimiento Como Real
	
	// leer entrada
	Escribir "Capital Invertido: " Sin Saltar
	Leer capitalInvertido
	
	// computacion
	rendimiento = capitalInvertido * 0.02
	
	// mostrar resultados
	Escribir "Los ", capitalInvertido, " euros a una tasa de interés del 2% tuvo un rendimiento de ",rendimiento, " euros."
FinAlgoritmo

	