Algoritmo sumarDosNumeros
	// Declarar variables
	Definir num1 Como Real
	Definir num2 Como Real
	Definir suma Como Real
	// Pedir números
	Escribir 'Tecla el primer número'Sin Saltar
	Leer num1
	Escribir 'Tecla el segundo número'Sin Saltar
	Leer num2
	// Computación
	suma <- num1+num2
	// Mostrar 
	Escribir 'La suma de los dos números: ', suma
FinAlgoritmo
